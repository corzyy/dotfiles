# Matugen template for btop — https://github.com/InioX/matugen-themes/blob/main/templates/btop.theme
# Generated by matugen from monochrome-dark (mode: dark) — do not edit manually

# Colors should be in 6 or 2 character hexadecimal or single spaced rgb decimal: "#RRGGBB", "#BW" or "0-255 0-255 0-255"
# example for white: "#ffffff", "#ff" or "255 255 255".

# All graphs and meters can be gradients
# For single color graphs leave "mid" and "end" variable empty.
# Use "start" and "end" variables for two color gradient
# Use "start", "mid" and "end" for three color gradient

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#e7e7e7"

# Title color for boxes
theme[title]="#e7e7e7"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ababab"

# Background color of selected item in processes box
theme[selected_bg]="#e7e7e7"

# Foreground color of selected item in processes box
theme[selected_fg]="#000000"

# Color of inactive/disabled text
theme[inactive_fg]="#ababab"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#9b9b9b"

# Cpu box outline color
theme[cpu_box]="#717171"

# Memory/disks box outline color
theme[mem_box]="#717171"

# Net up/down box outline color
theme[net_box]="#717171"

# Processes box outline color
theme[proc_box]="#717171"

# Box divider line and small boxes line color
theme[div_line]="#383838"

# Temperature graph colors
theme[temp_start]="#ababab"
theme[temp_mid]="#e7e7e7"
theme[temp_end]="#ffffff"

# CPU graph colors
theme[cpu_start]="#ababab"
theme[cpu_mid]="#e7e7e7"
theme[cpu_end]="#ffffff"

# Mem/Disk free meter
theme[free_start]="#ababab"
theme[free_mid]=""
theme[free_end]="#282828"

# Mem/Disk cached meter
theme[cached_start]="#9b9b9b"
theme[cached_mid]=""
theme[cached_end]="#282828"

# Mem/Disk available meter
theme[available_start]="#e7e7e7"
theme[available_mid]=""
theme[available_end]="#383838"

# Mem/Disk used meter
theme[used_start]="#ffffff"
theme[used_mid]=""
theme[used_end]="#474747"

# Download graph colors
theme[download_start]="#ababab"
theme[download_mid]="#e7e7e7"
theme[download_end]="#9b9b9b"

# Upload graph colors
theme[upload_start]="#ababab"
theme[upload_mid]="#e7e7e7"
theme[upload_end]="#9b9b9b"
